{
  "expo": {
    "name": "Poupix",
    "slug": "poupix",
    "scheme": "poupix",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-512.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/icon-192.png",
          "imageWidth": 128
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.poupix.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-maskable-512.png",
        "backgroundColor": "#059669"
      }
    }
  }
}
